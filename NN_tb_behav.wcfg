<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_dense_layer_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="tb_dense_layer" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.700 ns"></ZoomStartTime>
      <ZoomEndTime time="88.001 ns"></ZoomEndTime>
      <Cursor1Time time="35.000 ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="258"></NameColumnWidth>
      <ValueColumnWidth column_width="125"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="8" />
   <wvobject fp_name="/tb_dense_layer/clk" type="logic">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_dense_layer/reset" type="logic">
      <obj_property name="ElementShortName">reset</obj_property>
      <obj_property name="ObjectShortName">reset</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_dense_layer/layer_en" type="logic">
      <obj_property name="ElementShortName">layer_en</obj_property>
      <obj_property name="ObjectShortName">layer_en</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_dense_layer/neuron_out" type="array">
      <obj_property name="ElementShortName">neuron_out[0:2][31:0]</obj_property>
      <obj_property name="ObjectShortName">neuron_out[0:2][31:0]</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_dense_layer/biases" type="array">

      <obj_property name="ObjectShortName">weights[0:2][0:3][7:0]</obj_property>
      <obj_property name="Radix">SIGNEDDECRADIX</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_dense_layer/in_data" type="array">
